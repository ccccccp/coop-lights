# 独立模式直接运行游戏；真实宿主接入时改为 kook。
APP_MODE=standalone
# 前端可信宿主来源，多个 origin 用逗号分隔。localhost 仅用于本地联调。
VITE_KOOK_HOST_ORIGINS=https://tttt-www.dev.chuanyuapp.com,https://localhost:3000
WEB_PORT=5178
SERVER_PORT=5188
SERVER_HOST=127.0.0.1
# 实际发起游戏 API/WS 请求的页面 origin。部署时填写 HTTPS 游戏来源。
ALLOWED_GAME_ORIGINS=http://localhost:5178,http://127.0.0.1:5178,http://localhost:5188,http://127.0.0.1:5188
GAME_MAX_PLAYERS=4
GAME_RECONNECT_GRACE_MS=60000
GAME_SESSION_TTL_MS=604800000
ENABLE_DEV_FAULTS=true

# 留空时读取 .local/database.json；只配置本项目专用数据库。
DATABASE_URL=
# 仅原生 db:setup 使用；Docker 数据库使用 pnpm db:docker。
PG_ADMIN_URL=
# PG_BIN=C:/Program Files/PostgreSQL/17/bin
GAME_PG_PORT=55432

# 以下仅由游戏后端读取，不能添加 VITE_ 前缀或注入前端。
# dev:sdk 使用进程内的模拟配置，不需要填写这些值。
KOOK_CLIENT_ID=
KOOK_CLIENT_SECRET=
KOOK_REDIRECT_URI=
KOOK_TOKEN_URL=
KOOK_USERINFO_URL=
# 必须依据实际用户信息响应选择一个身份字段，并取消注释：
# KOOK_USER_ID_FIELD=user_open_code
# 可选：user_open_code / user_code / id；不能随意切换，否则会改变账号映射。
KOOK_USER_NAME_FIELD=username
