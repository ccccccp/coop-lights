# 复制为 .env；本文件只启用常用配置，可选项按需取消注释。
# 默认规则：1～4 人、断线保留 60 秒、会话最长 7 天；用户身份固定读取 id，显示名读取 username。

# 运行模式：standalone 直接输入昵称游玩；kook 从 KOOK 宿主打开并使用 OAuth 登录。
APP_MODE=standalone
# 实际发起 API / WebSocket 请求的游戏页面 origin，多个用逗号分隔，不带路径或末尾 /。
# 部署时改为 https://你的游戏域名；这是游戏来源，与下方 KOOK 宿主来源不同。
ALLOWED_GAME_ORIGINS=http://localhost:5178,http://127.0.0.1:5178,http://localhost:5188,http://127.0.0.1:5188
# 游戏专用 PostgreSQL 连接串；留空时复用 db:setup / db:docker 生成的 .local/database.json。
DATABASE_URL=

# KOOK 接入：以下三项仅在 APP_MODE=kook 时必填，凭证只由游戏后端读取。
# 开发者后台 OAuth2 页面中的 Client ID。
KOOK_CLIENT_ID=
# 同一应用的 Client Secret，不加 VITE_ 前缀。
KOOK_CLIENT_SECRET=
# 与开发者后台和宿主授权请求完全一致的完整回调 URL，例如 https://你的游戏域名/。
KOOK_REDIRECT_URI=
# 前端可信 KOOK 宿主 origin，多个用逗号分隔；本地联调按需添加 https://localhost:3000。
# 修改后重新启动 Vite 或重新构建；dev:sdk 自测时覆盖为 https://localhost:5190。
VITE_KOOK_HOST_ORIGINS=https://www.kookapp.cn
# KOOK 服务 origin，默认正式环境；连接测试后端时才修改，不带路径或末尾 /。
# token、用户资料和邀请上下文接口路径由代码自动拼接。
# KOOK_API_ORIGIN=https://www.kookapp.cn
# 点灯的游戏对外编号，默认 751wtNQveFXjlVoZ；平台分配其他编号时才修改。
# KOOK_GAME_CODE=751wtNQveFXjlVoZ

# 原生 HTTPS：本地 KOOK 联调用 WEB_HTTPS=true；普通独立模式使用默认 HTTP。
# 若由反向代理终止 HTTPS，保持 WEB_HTTPS / SERVER_HTTPS 为 false。
# WEB_HTTPS=false
# 构建后由游戏后端直接提供 HTTPS 时设为 true，pnpm dev 通常保持 false。
# SERVER_HTTPS=false
# 启用任一原生 HTTPS 时两项必填，支持绝对路径或相对项目根目录的路径。
# GAME_TLS_CERT=
# 与证书配套的 PEM 私钥文件路径。
# GAME_TLS_KEY=

# 日志查询访问密钥，仅服务端持有；留空禁用 /api/logs 查询，填写后重启后端。
LOG_ACCESS_KEY=
# 日志默认保留 7 天；只在需要调整时设置，范围为 3～90 天。
# LOG_RETENTION_DAYS=7

# 可选监听配置：默认前端 5178、后端 5188，仅端口冲突或部署需要时设置。
# WEB_PORT=5178
# SERVER_PORT=5188
# 默认后端仅监听本机；容器等需要外部访问时改为 0.0.0.0，并配置反向代理。
# SERVER_HOST=127.0.0.1
# 独立模式开发辅助接口默认开启；设为 false 可关闭，KOOK 或 production 环境始终关闭。
# ENABLE_DEV_FAULTS=true

# 以下仅供原生 pnpm db:setup 初始化使用；Docker 数据库使用 pnpm db:docker。
# PostgreSQL bin 目录，默认 D:/Program Files/PostgreSQL/17/bin，按本机安装位置修改。
# PG_BIN=D:/Program Files/PostgreSQL/17/bin
# 新建项目独立数据库实例的端口，默认 55432；已有 .local/database.json 时沿用原端口。
# GAME_PG_PORT=55432
# 可选管理员连接串：使用已有 PostgreSQL 创建游戏专用账号与数据库，默认新建独立实例。
# PG_ADMIN_URL=
