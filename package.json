{
  "name": "kook-coop-lights",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm --dir apps/server dev\" \"pnpm --dir apps/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "pnpm --dir apps/server start",
    "db:migrate": "pnpm --dir apps/server db:migrate",
    "db:setup": "pnpm --dir apps/server db:setup",
    "db:stop": "pnpm --dir apps/server db:stop"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
