{
  "name": "@lights/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:setup": "tsx src/setupDatabase.ts",
    "db:stop": "tsx src/setupDatabase.ts --stop"
  },
  "dependencies": {
    "@lights/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0"
  }
}
